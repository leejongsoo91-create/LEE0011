{
  "permissions": {
    "allow": [
      "mcp__playwright__*",
      "mcp__aside__repl",
      "mcp__aside__browser_profiles"
    ],
    "deny": [
      "mcp__aside__exec"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.mjs\""
          }
        ]
      }
    ]
  }
}

# 이 파일을 .env.local 로 복사한 뒤 Supabase 프로젝트의 값으로 채우세요. (.env.local 은 git에 올라가지 않습니다)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 텔레그램 일정 알림 (선택). 토큰은 브라우저에 노출되면 안 되므로 VITE_ 접두사를 붙이지 않습니다.
# Vercel > Settings > Environment Variables 에만 등록하세요. (로컬 `npm run dev`에서는 알림이 가지 않습니다)
# TELEGRAM_BOT_TOKEN=봇파더에서_받은_토큰
# TELEGRAM_CHAT_ID=내_채팅_ID
# 시간에 맞춘 알림(1분마다 확인)용. 서비스 롤 키는 모든 데이터에 접근할 수 있으니 절대 VITE_ 를 붙이거나 공개하지 마세요.
# CRON_SECRET=아무_긴_무작위_문자열 (Supabase cron SQL에 넣는 값과 똑같이)
# SUPABASE_SERVICE_ROLE_KEY=Supabase > Settings > API 의 service_role 키
# 텔레그램 웹훅(api/webhook.js)이 진짜 텔레그램 요청인지 확인하는 값. 직접 만든 무작위 문자열(영문·숫자·_·-, 30자 이상)을
# setWebhook 주소의 &secret_token= 과 여기에 똑같이 넣습니다. AGENT_MODE=on 이면 필수(없으면 에이전트가 요청을 처리하지 않음).
# TELEGRAM_WEBHOOK_SECRET=영문숫자_무작위_문자열
# 결재 통제형 멀티 에이전트. on 이면 봇에 보낸 지시를 AI가 계획하고, 데이터를 바꾸는 계획은 결재 버튼으로 승인받아 실행합니다.
# 값이 없거나 on 이 아니면 echo 응답만 합니다. (agent_tasks 테이블 SQL과 TELEGRAM_WEBHOOK_SECRET이 먼저 있어야 합니다)
# AGENT_MODE=on
# AI 계획 작성기(3단계). Anthropic 콘솔에서 만든 키를 Vercel 환경변수에만 넣으세요. (채팅·코드·VITE_ 접두사 금지)
# 키가 없으면 2단계의 테스트 계획 작성기(낱말 시나리오)로 동작합니다.
# ANTHROPIC_API_KEY=sk-ant-...
# 역할별 프로그램 (api/_agents/agents.config.js). 메인·크로스체크에 어떤 프로그램을 쓸지는 캡틴이 정합니다.
# AGENT_PROGRAM_MAIN=anthropic          # anthropic | test (기본: 키가 있으면 anthropic)
# AGENT_MODEL_MAIN=claude-sonnet-5-5    # 예전 이름 AGENT_MODEL도 됩니다
# AGENT_PROGRAM_CROSSCHECK=off          # off(코드 검사만) | test(상의 흐름 확인용: "이의 테스트")
# AGENT_MODEL_CROSSCHECK=
# AGENT_PLANNING_BUDGET_MS=50000        # 계획·상의 시간 예산 (웹훅 함수 한도 60초 안)
# 예전 설정(계속 동작): AGENT_MODEL=claude-sonnet-5-5, AGENT_PLANNER=test
# 선택: 대시보드 주인의 Supabase user id. 비워 두면 Auth 사용자가 1명일 때 자동으로 그 사람을 씁니다.
# AGENT_USER_ID=
